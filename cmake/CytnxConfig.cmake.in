@PACKAGE_INIT@

# The dependency lookups below are wrapped in block(SCOPE_FOR VARIABLES), which
# needs CMake >= 3.25 — the same floor cytnx itself is built with. Report that
# as a package-not-found reason instead of letting CMake fail on an unknown
# command. cmake_minimum_required() is deliberately not used here: it would
# apply cytnx's policy settings to the consuming project's scope.
if(CMAKE_VERSION VERSION_LESS 3.25)
  set(Cytnx_NOT_FOUND_MESSAGE
    "Cytnx requires CMake 3.25 or newer to be consumed; this is CMake ${CMAKE_VERSION}.")
  set(Cytnx_FOUND FALSE)
  return()
endif()

include(CMakeFindDependencyMacro)

find_dependency(Boost CONFIG REQUIRED)

# Conditional re-find of build-time PUBLIC imported-target deps.
# Plain absolute-path link entries (e.g. ${ARPACK_LIB}) do not need this — they
# were baked into INTERFACE_LINK_LIBRARIES as paths. Imported targets (CUDA::*,
# OpenMP::*, MORSE::LAPACKE) only exist after the corresponding
# find_package runs in the consumer's project, so we recreate them here when
# cytnx was built with the matching flag. Each token below wrapped in at signs
# is substituted with that option's build-time value by
# configure_package_config_file when CytnxConfig.cmake is emitted — including
# @USE_MKL@, which selects the same BLAS/LAPACK branch the build took.
if(@USE_CUDA@)
  find_dependency(CUDAToolkit REQUIRED)
endif()

# The lookups below share one block(SCOPE_FOR VARIABLES): they all need
# CMAKE_MODULE_PATH pointed at the finders shipped with cytnx, and the BLAS
# vendor cytnx was built against, without either escaping into the consuming
# project. The imported targets they create are directory-scoped, not
# block-scoped, so they stay visible afterwards -- which is the whole point.
# Boost, CUDAToolkit and OpenMP stay outside: a consumer legitimately reads the
# result variables those set, and this block would swallow them.
#
# Morse's FindLAPACKE and its helper closure, plus cytnx's own FindCUTENSOR
# and FindCUQUANTUM: the source tree for a build-tree consumer, the
# copies inside the package for an installed one. Load them by module path
# rather than including Morse's top-level MorseInit.cmake, which would rewrite
# project-wide options, CMAKE_BUILD_TYPE, CMAKE_INCLUDE_PATH and
# CMAKE_LIBRARY_PATH in the consumer. FindLAPACKE includes FindMorseInit itself,
# which is the finder-only subset of those macros.
block(SCOPE_FOR VARIABLES)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/morse" "${CMAKE_CURRENT_LIST_DIR}/Modules")

  # Ask for the BLAS/LAPACK vendor cytnx was built against. This steers a lookup
  # that has not happened yet; it cannot redirect one that has, because neither
  # finder replaces a target that already exists: FindLAPACK creates
  # LAPACK::LAPACK only when no target of that name exists, and FindBLAS does the
  # same for BLAS::BLAS. A pre-existing BLAS::BLAS reaches cytnx's link line even
  # when no LAPACK target existed, because FindLAPACK drops BLAS_LIBRARIES from
  # the LAPACK::LAPACK it creates and links that BLAS target in their place.
  #
  # Warn rather than bind silently: an OpenBLAS/reference or MKL LP64/ILP64
  # mismatch miscomputes instead of failing loudly. Warn rather than fail,
  # because a consumer that deliberately resolved the matching implementation
  # first is a legitimate ordering, and telling the two apart from here would
  # mean comparing against the build machine's library paths.
  set(BLA_VENDOR "@BLA_VENDOR@")
  set(_cytnx_preexisting_blas "")
  if(TARGET LAPACK::LAPACK)
    list(APPEND _cytnx_preexisting_blas "LAPACK::LAPACK")
  endif()
  if(TARGET BLAS::BLAS)
    list(APPEND _cytnx_preexisting_blas "BLAS::BLAS")
  endif()
  if(_cytnx_preexisting_blas AND NOT "@BLA_VENDOR@" STREQUAL "")
    list(JOIN _cytnx_preexisting_blas " and " _cytnx_preexisting_blas_names)
    message(WARNING
      "Cytnx was built against BLA_VENDOR=@BLA_VENDOR@, but this project "
      "already defines ${_cytnx_preexisting_blas_names}, which the lookup below "
      "will reuse rather than recreate -- so Cytnx will link whatever those "
      "targets name. Check that they are the same BLAS/LAPACK implementation "
      "and integer ABI: resolve BLAS and LAPACK with BLA_VENDOR=@BLA_VENDOR@ "
      "before find_package(Cytnx), or find Cytnx first.")
  endif()

  # cytnx's BLAS/LAPACK requirement is PUBLIC: the installed header
  # backend/lapack_wrapper.hpp includes <lapacke.h> (or <mkl.h> under UNI_MKL),
  # so a consumer compiling it needs those headers, and a consumer linking the
  # static libcytnx.a needs those libraries. CytnxTargets.cmake names only the
  # imported target, so rerun the finder that creates it here -- against the
  # consumer's own installation, which is what keeps the package relocatable.
  #
  # LAPACK first, matching the order cytnx itself uses. cytnx links
  # LAPACK::LAPACK directly, and FindLAPACKE below needs LAPACK anyway
  # ("LAPACKE requires LAPACK but LAPACK has not been found"), so this adds no
  # requirement a LAPACKE lookup would not already impose.
  find_dependency(LAPACK REQUIRED)
  if(NOT @USE_MKL@)
    # A standalone LAPACKE is a separate library from the LAPACK under it, so
    # LAPACK::LAPACK alone does not resolve the LAPACKE_* entry points (nor
    # provide <lapacke.h>). Recreate MORSE::LAPACKE for those.
    #
    # find_package rather than find_dependency, because find_dependency skips a
    # call whose arguments match one another package config already made in this
    # directory. That heuristic cannot see that this block just put cytnx's own
    # FindLAPACKE on CMAKE_MODULE_PATH, so a project that resolved LAPACKE
    # through a different finder first would leave MORSE::LAPACKE uncreated and
    # the exported cytnx target naming a target that does not exist. MODULE for
    # the same reason as the build: under CMAKE_FIND_PACKAGE_PREFER_CONFIG the
    # basic signature would prefer a LAPACKEConfig.cmake, which defines no such
    # target. The target is checked after the block, where reporting a
    # package-not-found reason is in scope.
    find_package(LAPACKE MODULE)
  endif()

  # cytnx applies UNI_CUTENSOR / UNI_CUQUANTUM PUBLIC, which makes the installed
  # headers cytnx_error.hpp and Network.hpp include <cutensor.h> /
  # <cutensornet.h>. Recreate the imported targets carrying those include dirs
  # from the consumer's own CUTENSOR_ROOT / CUQUANTUM_ROOT. Both finders read
  # CUDAToolkit variables, so they must run after the find_dependency
  # (CUDAToolkit) above.
  #
  # Skip the lookup when the consuming project already supplies the target: it
  # already satisfies the exported cytnx target, and these finders raise a fatal
  # error when their *_ROOT is unset, so running one anyway would fail
  # find_package(Cytnx) over a dependency that is in fact present.
  if(@USE_CUTENSOR@ AND NOT TARGET CUTENSOR::CUTENSOR)
    find_dependency(CUTENSOR MODULE REQUIRED)
  endif()

  if(@USE_CUQUANTUM@ AND NOT TARGET CUQUANTUM::CUQUANTUM)
    find_dependency(CUQUANTUM MODULE REQUIRED)
  endif()
endblock()

# The LAPACKE lookup above is not REQUIRED, so report a missing MORSE::LAPACKE
# here -- outside the block, where the result variables reach find_package.
# Without it, CytnxTargets.cmake would name a target that does not exist and the
# consumer would fail at generate time instead of at find_package(Cytnx).
if(NOT @USE_MKL@ AND NOT TARGET MORSE::LAPACKE)
  set(Cytnx_NOT_FOUND_MESSAGE
    "Cytnx requires LAPACKE, but MORSE::LAPACKE was not created by the FindLAPACKE shipped with Cytnx. Check that LAPACKE is installed where CMake can find it.")
  set(Cytnx_FOUND FALSE)
  return()
endif()

if(@USE_HPTT@)
  # libcytnx is a STATIC archive; libhptt.a (which uses OpenMP internally)
  # gets pulled in by reference, so the consumer's final executable link
  # needs OpenMP to resolve libhptt's `__kmpc_*` / `omp_*` symbols. See
  # commit 5733a441 ("Propagate `-fopenmp` linking flag when using HPTT").
  find_dependency(OpenMP REQUIRED)
endif()

if(NOT TARGET Cytnx::cytnx)
    include("${CMAKE_CURRENT_LIST_DIR}/CytnxTargets.cmake")
endif()

if(@USE_CUDA@)
  # cytnx was built with UNI_GPU (applied PUBLIC), so its public header Type.hpp
  # includes <cuda/std/complex>. CUDA 12+/13 relocate that header under the
  # toolkit's cccl/ subdir, which is in no CUDA:: imported target's INTERFACE.
  # The build tree added the dir only through $<BUILD_INTERFACE:>, so the
  # exported target carries no cccl path. Re-detect it against the consumer's own
  # CUDAToolkit (found above) and append it to the imported target's interface
  # includes — this stays relocatable because the path comes from the consumer's
  # toolkit, not the build machine. Detection is shared with the in-tree build.
  include("${CMAKE_CURRENT_LIST_DIR}/CytnxDetectCCCL.cmake")
  cytnx_detect_cccl_include_dir(_cytnx_cccl_dir)
  if(_cytnx_cccl_dir)
    set_property(TARGET Cytnx::cytnx APPEND PROPERTY
      INTERFACE_INCLUDE_DIRECTORIES "${_cytnx_cccl_dir}")
  endif()
endif()

check_required_components(Cytnx)
